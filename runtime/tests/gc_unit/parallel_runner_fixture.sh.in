#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--gtest_list_tests" ]]; then
  printf '@SUITE@.\n  @FIRST@\n  @SECOND@\n'
  exit 0
fi
test_name=${1#--gtest_filter=}
printf '[  RUN   ] %s\n' "$test_name"
if [[ "${GC_UNIT_FAKE_FAIL:-}" == "$test_name" ]]; then
  printf '[  FAIL  ] %s\n' "$test_name"
  printf '[========] 1 tests: 0 passed, 1 failed\n' >"${GC_UNIT_TALLY_FILE:?}"
  exit 1
fi
printf '[  PASS  ] %s\n' "$test_name"
printf '[========] 1 tests: 1 passed, 0 failed\n' >"${GC_UNIT_TALLY_FILE:?}"
