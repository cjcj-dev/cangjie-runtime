{
  "owner": "metadata-platform",
  "editWorkflow": false,
  "readyForNativeExecution": false,
  "packageDir": ".",
  "packages": [
    "ndk;27.3.13750724",
    "platform-tools",
    "emulator",
    "system-images;android-31;google_apis;x86_64"
  ],
  "scripts": [
    "scene.mjs",
    "capture.py",
    "lldb-commands.txt"
  ],
  "requiredEnv": [
    "SCENE_COMMANDS",
    "HOST_SYMBOLS",
    "RUNTIME_SO",
    "ANDROID_SDK_ROOT",
    "ANDROID_SERIAL"
  ],
  "notUsed": [
    "SCENE_OBSERVER",
    "classifyFullImageExit",
    "EXIT_SHELL"
  ],
  "prepare": "node scene.mjs self-test && node scene.mjs calibrate",
  "execute": "SCENE_EXECUTE=1 node scene.mjs execute",
  "executeThisLane": "not invoked",
  "sameDrive": true,
  "consumer": "node scene.mjs execute reads the entry-stop snapshot and mutex-events.json. Crash export is an -k command, not a later ordinary -o. quit after detach is not a business exit",
  "budget": {
    "minutes": 45,
    "jobs": 2,
    "core": 0,
    "activeSeconds": 60,
    "totalSeconds": 300
  },
  "mode": "preinit/full-image",
  "forbid": [
    "runtime-fini",
    "no-image",
    "NoFP",
    "retry",
    "ndk-gdb",
    "simulated sceneSuccess",
    "host-pid kill",
    "-S before target",
    "synthetic EXIT_SHELL",
    "literal build-id token",
    "shell classifier",
    "lldb rc as business exit",
    "lldb uuid as gnu build id",
    "relink to add a note"
  ]
}
