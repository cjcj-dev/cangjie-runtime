# Mach-O links keep DWARF in the input objects and only reference it through a debug map, so a
# standard-library dylib delivers its debug information as the .dSYM bundle built from that dylib.
#
# The bundle is a build output of its own edge, not a side effect of the link: its Info.plist and
# DWARF payload are declared OUTPUTs that depend on the linked dylib. A missing or partial bundle
# next to an up-to-date dylib is therefore regenerated by the normal build before install consumes
# it, without relinking the dylib, and a relinked dylib always regenerates its bundle.
#
include_guard(GLOBAL)

# cangjie_std_dsym(<out_outputs_var> <dylib_path> DEPENDS <file-or-target>...)
#   <dylib_path>  absolute path of the linked dylib; the bundle is <dylib_path>.dSYM.
#   DEPENDS       what produces <dylib_path> (the dylib file and/or the target that links it).
# Sets <out_outputs_var> to the declared bundle files; callers add them to an ALL target.
function(cangjie_std_dsym out_outputs dylib)
    cmake_parse_arguments(PARSE_ARGV 2 CANGJIE_DSYM "" "" "DEPENDS")
    if(NOT CANGJIE_DSYMUTIL)
        message(FATAL_ERROR "cangjie_std_dsym: CANGJIE_DSYMUTIL is not set")
    endif()
    if(NOT IS_ABSOLUTE "${dylib}")
        message(FATAL_ERROR "cangjie_std_dsym: ${dylib} is not an absolute path")
    endif()
    get_filename_component(dylib_name "${dylib}" NAME)
    set(bundle "${dylib}.dSYM")
    set(info_plist "${bundle}/Contents/Info.plist")
    # dsymutil names the DWARF payload after the input binary.
    set(dwarf "${bundle}/Contents/Resources/DWARF/${dylib_name}")
    add_custom_command(
        OUTPUT ${info_plist} ${dwarf}
        # Start from an empty bundle so no stale payload survives a failed or partial previous run.
        COMMAND ${CMAKE_COMMAND} -E remove_directory ${bundle}
        COMMAND ${CANGJIE_DSYMUTIL} ${dylib} -o ${bundle}
        # Fail the edge if dsymutil exited 0 without writing the declared outputs.
        COMMAND ${CMAKE_COMMAND} -E sha256sum ${info_plist} ${dwarf}
        DEPENDS ${CANGJIE_DSYM_DEPENDS}
        COMMENT "Generating ${bundle}"
        VERBATIM)
    set(${out_outputs} ${info_plist} ${dwarf} PARENT_SCOPE)
endfunction()

# cangjie_std_target_dsym(<shared_library_target> <out_dylib_var> <out_outputs_var>)
# Same as cangjie_std_dsym for a dylib linked by a CMake SHARED library target. OUTPUT paths cannot
# use generator expressions, so the dylib path is derived from the target properties; properties
# that would move or rename the file are rejected instead of guessed.
function(cangjie_std_target_dsym target out_dylib out_outputs)
    foreach(property OUTPUT_NAME LIBRARY_OUTPUT_NAME PREFIX SUFFIX VERSION SOVERSION)
        get_target_property(value ${target} ${property})
        if(value)
            message(FATAL_ERROR "cangjie_std_target_dsym: ${target} ${property} is set; its .dSYM output path is unknown")
        endif()
    endforeach()
    get_target_property(dir ${target} LIBRARY_OUTPUT_DIRECTORY)
    if(CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" config)
        get_target_property(config_dir ${target} LIBRARY_OUTPUT_DIRECTORY_${config})
        if(config_dir)
            set(dir ${config_dir})
        endif()
    endif()
    if(NOT dir)
        message(FATAL_ERROR "cangjie_std_target_dsym: ${target} has no LIBRARY_OUTPUT_DIRECTORY; its .dSYM output path is unknown")
    endif()
    set(dylib ${dir}/${CMAKE_SHARED_LIBRARY_PREFIX}${target}${CMAKE_SHARED_LIBRARY_SUFFIX})
    cangjie_std_dsym(outputs ${dylib} DEPENDS ${target} $<TARGET_FILE:${target}>)
    set(${out_dylib} ${dylib} PARENT_SCOPE)
    set(${out_outputs} ${outputs} PARENT_SCOPE)
endfunction()
