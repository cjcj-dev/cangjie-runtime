    --check               如果变更中引入冲突定界符或空白错误，给出警告
    --summary             精简摘要，例如创建、重命名和模式变更
    --name-only           只显示变更文件的文件名
    --name-status         只显示变更文件的文件名和状态
    --stat[=<宽度>[,<文件名宽度>[,<次数>]]]
