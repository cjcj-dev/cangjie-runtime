    --stat-count <次数>   生成有限行数的差异统计
    --compact-summary     生成差异统计的简洁摘要
    --binary              输出一个可以应用的二进制差异
    --full-index          在 "index" 行显示完整的前后对象名称
    --color[=<何时>]      显示带颜色的差异
    --ws-error-highlight <类型>
